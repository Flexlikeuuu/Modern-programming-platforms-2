<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Project Tracker</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

  <div class="container">
    <header>
      <h1>Project Tracker</h1>
    </header>

    <div class="section-card">
      <h2 class="section-title">Новая задача</h2>
      <form action="/items/create" method="POST" class="form-grid">
        <input type="text" name="title" placeholder="Название задачи" required>
        <input type="text" name="category" placeholder="Категория (например, Backend)" required>
        <input type="date" name="dueDate" required>
        <button type="submit">Добавить</button>
      </form>
    </div>

    <div class="section-card">
      <h2 class="section-title">Фильтры</h2>
      <form action="/" method="GET" class="form-grid">
        <div class="filter-group">
          <label>Статус</label>
          <select name="statusFilter">
            <option value="all" <%= selectedStatus === 'all' ? 'selected' : '' %>>Все</option>
            <option value="pending" <%= selectedStatus === 'pending' ? 'selected' : '' %>>В очереди</option>
            <option value="in_progress" <%= selectedStatus === 'in_progress' ? 'selected' : '' %>>В работе</option>
            <option value="completed" <%= selectedStatus === 'completed' ? 'selected' : '' %>>Завершено</option>
          </select>
        </div>

        <div class="filter-group">
          <label>Категория</label>
          <select name="categoryFilter">
            <option value="all" <%= selectedCategory === 'all' ? 'selected' : '' %>>Все</option>
            <% categories.forEach(cat => { %>
              <option value="<%= cat %>" <%= selectedCategory === cat ? 'selected' : '' %>><%= cat %></option>
            <% }) %>
          </select>
        </div>

        <div style="display: flex; gap: 0.5rem; align-items: flex-end;">
          <button type="submit" style="flex: 1;">Применить</button>
          <a href="/" style="padding: 0.625rem; color: var(--text-muted); text-decoration: none; font-size: 0.85rem;">Сброс</a>
        </div>
      </form>
    </div>

    <% if (items.length === 0) { %>
      <div class="section-card empty-state">
        <p>Задач пока нет. Добавьте первую задачу с помощью формы выше!</p>
      </div>
    <% } %>

    <% items.forEach(item => { 
      const isOverdue = new Date(item.dueDate) < new Date() && item.status !== 'completed';
    %>
      <div class="task-card <%= isOverdue ? 'overdue' : '' %>">
        <div class="task-header">
          <h3 class="task-title"><%= item.title %></h3>
          <span class="badge status-<%= item.status %>">
            <%= item.status === 'pending' ? 'В очереди' : item.status === 'in_progress' ? 'В работе' : 'Завершено' %>
          </span>
        </div>

        <div class="task-meta">
          <span>Категория: <strong><%= item.category %></strong></span>
          <span>
            Срок: <strong><%= item.dueDate %></strong>
            <% if (isOverdue) { %><span class="overdue-tag">(Просрочено)</span><% } %>
          </span>
        </div>

        <% if (item.attachments.length > 0) { %>
          <div class="files-container">
            <strong>Прикрепленные файлы:</strong>
            <ul class="files-list">
              <% item.attachments.forEach(file => { %>
                <li><a href="<%= file.path %>" target="_blank">📄 <%= file.originalName %></a></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <div class="actions-bar">
          <form action="/items/<%= item.id %>/status" method="POST">
            <select name="status" onchange="this.form.submit()">
              <option value="pending" <%= item.status === 'pending' ? 'selected' : '' %>>В очередь</option>
              <option value="in_progress" <%= item.status === 'in_progress' ? 'selected' : '' %>>В работу</option>
              <option value="completed" <%= item.status === 'completed' ? 'selected' : '' %>>Завершить</option>
            </select>
          </form>

          <form action="/items/<%= item.id %>/upload" method="POST" enctype="multipart/form-data" class="upload-form">
            <input type="file" name="attachment" required>
            <button type="submit">Прикрепить</button>
          </form>

          <form action="/items/<%= item.id %>/delete" method="POST" style="margin-left: auto;">
            <button type="submit" class="btn-danger">Удалить</button>
          </form>
        </div>
      </div>
    <% }) %>

  </div>

</body>
</html>